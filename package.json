{
  "name": "rhiza-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite --host 127.0.0.1 --port 4173\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --platform node --out-dir dist-server --clean",
    "start": "node dist-server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --exclude 'e2e/**'",
    "test:e2e": "vitest run e2e",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:status": "tsx scripts/migrate.ts status",
    "licenses:generate": "node scripts/generate-license-report.mjs",
    "licenses:verify": "node scripts/generate-license-report.mjs --check",
    "benchmark:m5": "tsx scripts/benchmark-planner.ts",
    "verify:m0": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e && npm run licenses:verify && npm run build",
    "verify:m1": "npm run verify:m0",
    "verify:m2": "npm run verify:m1",
    "verify:m3": "npm run verify:m2",
    "verify:m4": "npm run verify:m3",
    "verify:m5": "npm run verify:m4",
    "verify:m6": "npm run verify:m5 && npm run typecheck && vitest run src/App.test.tsx"
  },
  "dependencies": {
    "@fontsource/dm-mono": "latest",
    "@fontsource/manrope": "latest",
    "@fontsource/newsreader": "latest",
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "express": "latest",
    "katex": "^0.18.3",
    "librechat-data-provider": "0.8.509",
    "lucide-react": "latest",
    "mermaid": "^11.16.1",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/express": "latest",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "concurrently": "latest",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "supertest": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "latest"
  }
}
