{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhiza.dev/architecture-gates/workspace-fixture/1.0.0",
  "type": "object", "required": ["fixtureVersion", "id", "workspace"], "additionalProperties": false,
  "properties": { "fixtureVersion": { "const": "1.0.0" }, "id": { "type": "string" }, "workspace": { "$ref": "#/$defs/workspace" } },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "workspace": { "type": "object", "required": ["projectId", "projectTitle", "nodeId", "mode", "contextItems", "messages", "attachments", "fileChunks", "discussionNodes", "discussionEdges", "anchors", "activeNodeId", "manifests", "segments", "auditEvents", "updatedAt"], "additionalProperties": false, "properties": { "projectId": { "$ref": "#/$defs/id" }, "projectTitle": { "type": "string" }, "nodeId": { "$ref": "#/$defs/id" }, "mode": { "enum": ["Auto", "Assisted", "Strict"] }, "contextItems": { "type": "array", "items": { "$ref": "#/$defs/contextItem" } }, "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } }, "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } }, "fileChunks": { "type": "array", "items": { "$ref": "#/$defs/fileChunk" } }, "discussionNodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }, "discussionEdges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }, "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } }, "activeNodeId": { "$ref": "#/$defs/id" }, "manifests": { "type": "array" }, "segments": { "type": "array" }, "auditEvents": { "type": "array" }, "updatedAt": { "type": "string", "format": "date-time" } } },
    "contextItem": { "type": "object", "required": ["id", "sourceType", "sourceId", "sourceNodeId", "status", "tokens"], "properties": { "id": { "$ref": "#/$defs/id" }, "sourceType": { "type": "string" }, "sourceId": { "$ref": "#/$defs/id" }, "sourceNodeId": { "$ref": "#/$defs/id" }, "status": { "enum": ["active", "recommended", "excluded"] }, "tokens": { "type": "integer", "minimum": 0 } } },
    "message": { "type": "object", "required": ["id", "nodeId", "kind", "text", "createdAt"], "properties": { "id": { "$ref": "#/$defs/id" }, "nodeId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["user", "assistant"] }, "text": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } },
    "attachment": { "type": "object", "required": ["id", "name", "mimeType", "size", "kind", "createdAt"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "mimeType": { "type": "string" }, "size": { "type": "integer", "minimum": 0 }, "kind": { "enum": ["file", "image"] }, "createdAt": { "type": "string", "format": "date-time" } } },
    "fileChunk": { "type": "object", "required": ["id", "attachmentId", "ordinal", "text", "startOffset", "endOffset"], "properties": { "id": { "$ref": "#/$defs/id" }, "attachmentId": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 0 }, "text": { "type": "string" }, "startOffset": { "type": "integer", "minimum": 0 }, "endOffset": { "type": "integer", "minimum": 0 } } },
    "node": { "type": "object", "required": ["id", "status", "kind", "title", "summary"], "properties": { "id": { "$ref": "#/$defs/id" }, "sourceNodeId": { "$ref": "#/$defs/id" }, "sourceMessageId": { "$ref": "#/$defs/id" }, "status": { "enum": ["active", "draft", "resolved", "archived"] }, "kind": { "enum": ["main", "branch"] }, "title": { "type": "string" }, "summary": { "type": "string" } } },
    "edge": { "type": "object", "required": ["id", "source", "target", "relation"], "properties": { "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/id" }, "relation": { "type": "string" } } },
    "anchor": { "type": "object", "required": ["id", "nodeId", "messageId"], "properties": { "id": { "$ref": "#/$defs/id" }, "nodeId": { "$ref": "#/$defs/id" }, "messageId": { "$ref": "#/$defs/id" } } }
  }
}
