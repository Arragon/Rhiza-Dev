{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhiza.dev/architecture-gates/fixture-registry/1.0.0",
  "type": "object",
  "required": ["schema_version", "schema_id", "provenance", "canonicalization_version", "total_size_bytes", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "schema_id": { "const": "https://rhiza.dev/architecture-gates/fixture-registry/1.0.0" },
    "provenance": { "const": "synthetic" },
    "canonicalization_version": { "const": "jcs-like-key-sort-v1" },
    "total_size_bytes": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "fixtures": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "path", "schema_id", "digest", "size_bytes", "scenario_ids", "purpose"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "path": { "type": "string", "pattern": "^fixtures/[a-z0-9-]+\\.json$" },
          "schema_id": { "type": "string", "format": "uri" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "scenario_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
